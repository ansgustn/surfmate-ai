# 비워두면 db/seed/spots.json 을 사용 (DB 없이 실행 가능)
# docker compose up -d 후 아래 주석 해제
# DATABASE_URL=postgresql://surf:surf@localhost:5432/surf

# 기상 데이터: 기본은 Open-Meteo(인증키 불필요). 오프라인 개발 시 mock
# WEATHER_PROVIDER=mock

# 기상청 API허브(apihub.kma.go.kr) 인증키 — '해양기상종합관측' 활용신청 필요
# KMA_AUTH_KEY=

# 챗봇 (Ollama 로컬 LLM)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b   # 저사양 PC 는 qwen2.5:3b

# 공공데이터포털 일반 인증키(Decoding) — 한국관광공사 관광지 집중률·지역별 방문자수
# DATA_GO_KR_KEY=
